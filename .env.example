PUBLIC_BASE_URL=https://bpmn.example.ru
WEB_USERNAME=admin
WEB_PASSWORD=replace-with-a-long-random-password
MCP_API_KEY=replace-with-a-long-random-api-key

# Optional settings
HOST_PORT=3000
MCP_RATE_LIMIT_PER_MINUTE=60
MAX_BPMN_BYTES=2097152
# Opt-in experimental JSON endpoint; existing XML MCP remains available.
ENABLE_JSON_MCP=false
