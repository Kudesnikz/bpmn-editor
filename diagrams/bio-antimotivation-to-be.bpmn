      <bpmndi:BPMNEdge id="Flow_TOBE_B6_YES_di" bpmnElement="Flow_TOBE_B6_YES"><di:waypoint x="980" y="613" /><di:waypoint x="1060" y="613" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_TOBE_B6_NO_di" bpmnElement="Flow_TOBE_B6_NO"><di:waypoint x="955" y="638" /><di:waypoint x="955" y="702" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_TOBE_B7_YES_di" bpmnElement="Flow_TOBE_B7_YES"><di:waypoint x="1110" y="613" /><di:waypoint x="1150" y="613" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_TOBE_B7_NO_di" bpmnElement="Flow_TOBE_B7_NO"><di:waypoint x="1085" y="638" /><di:waypoint x="1085" y="702" /></bpmndi:BPMNEdge>
