      <bpmndi:BPMNEdge id="Flow_TOBE_B9_di" bpmnElement="Flow_TOBE_B9"><di:waypoint x="1490" y="613" /><di:waypoint x="1530" y="613" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_TOBE_B10_di" bpmnElement="Flow_TOBE_B10"><di:waypoint x="1665" y="613" /><di:waypoint x="1705" y="613" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_TOBE_B11_di" bpmnElement="Flow_TOBE_B11"><di:waypoint x="1860" y="613" /><di:waypoint x="1900" y="613" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_TOBE_B12_di" bpmnElement="Flow_TOBE_B12"><di:waypoint x="2055" y="613" /><di:waypoint x="2095" y="613" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_TOBE_B13_YES_di" bpmnElement="Flow_TOBE_B13_YES"><di:waypoint x="2120" y="638" /><di:waypoint x="2120" y="690" /><di:waypoint x="2190" y="690" /></bpmndi:BPMNEdge>
