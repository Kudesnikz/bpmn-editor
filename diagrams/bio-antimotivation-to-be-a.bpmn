<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
 xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
 id="Definitions_BIO_TOBE_A" targetNamespace="https://sergeygalay.github.io/bpmn-editor/bio-antimotivation-to-be-a">
  <bpmn:collaboration id="Collab_TOBE_A">
    <bpmn:participant id="Participant_User_A" name="Пользователь" />
    <bpmn:participant id="Participant_BIO_A" name="БИО" processRef="Process_BIO_A" />
    <bpmn:participant id="Participant_ASUP_A" name="АСУП" />
    <bpmn:messageFlow id="MF_Submit_A" name="Зарегистрированная опасность" sourceRef="Participant_User_A" targetRef="Start_Submit_A" />
    <bpmn:messageFlow id="MF_Notify_A" name="Изменение баллов / статуса" sourceRef="Task_Notify_A" targetRef="Participant_User_A" />
    <bpmn:messageFlow id="MF_ASUP_Request_A" name="Запрос периодов отсутствия" sourceRef="Task_RequestASUP_A" targetRef="Participant_ASUP_A" />
    <bpmn:messageFlow id="MF_ASUP_Response_A" name="Отпуск / больничный" sourceRef="Participant_ASUP_A" targetRef="Task_ReceiveASUP_A" />
  </bpmn:collaboration>

  <bpmn:process id="Process_BIO_A" name="TO BE A — Сгорание баллов при неактивности" isExecutable="false">
    <bpmn:laneSet id="LaneSet_A">
      <bpmn:lane id="Lane_Moderation_A" name="Модерация">
        <bpmn:flowNodeRef>Start_Submit_A</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Moderate_A</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Accepted_A</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Reject_A</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected_A</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Progress_A" name="Баллы и активность">
        <bpmn:flowNodeRef>Task_Award_A</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecordActivity_A</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecalcEarned_A</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Activity_A</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_Check_A</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestASUP_A</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveASUP_A</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CalcInactivity_A</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_CurrentAbsence_A</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Level_A</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Threshold_A</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Due_A</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Deduct_A</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecalcAfterDeduct_A</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Notify_A</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Paused_A</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_NotApplicable_A</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_NotDue_A</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Deducted_A</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_Submit_A" name="Опасность зарегистрирована"><bpmn:messageEventDefinition id="MED_Submit_A"/></bpmn:startEvent>
    <bpmn:userTask id="Task_Moderate_A" name="Проверить опасность"/>
    <bpmn:exclusiveGateway id="Gw_Accepted_A" name="Опасность подтверждена?"/>
    <bpmn:serviceTask id="Task_Reject_A" name="Отклонить заявку"/>
    <bpmn:endEvent id="End_Rejected_A" name="Баллы не начислены"/>
    <bpmn:serviceTask id="Task_Award_A" name="Начислить баллы"/>
    <bpmn:serviceTask id="Task_RecordActivity_A" name="Зафиксировать подтвержденную активность"/>
    <bpmn:serviceTask id="Task_RecalcEarned_A" name="Пересчитать статус"/>
    <bpmn:endEvent id="End_Activity_A" name="Активность учтена"/>

    <bpmn:startEvent id="Start_Check_A" name="Плановая проверка неактивности"><bpmn:timerEventDefinition id="TED_Check_A"/></bpmn:startEvent>
    <bpmn:sendTask id="Task_RequestASUP_A" name="Запросить периоды отсутствия"/>
    <bpmn:receiveTask id="Task_ReceiveASUP_A" name="Получить данные АСУП"/>
    <bpmn:serviceTask id="Task_CalcInactivity_A" name="Рассчитать неактивность без отпусков и больничных"/>
    <bpmn:exclusiveGateway id="Gw_CurrentAbsence_A" name="Сотрудник сейчас отсутствует?"/>
    <bpmn:endEvent id="End_Paused_A" name="Таймер приостановлен"/>
    <bpmn:exclusiveGateway id="Gw_Level_A" name="Уровень ≥ «Энтузиаст»?"/>
    <bpmn:exclusiveGateway id="Gw_Threshold_A" name="Достигнут порог неактивности?"/>
    <bpmn:exclusiveGateway id="Gw_Due_A" name="Наступила дата списания?"/>
    <bpmn:serviceTask id="Task_Deduct_A" name="Списать баллы по утвержденному правилу"/>
    <bpmn:serviceTask id="Task_RecalcAfterDeduct_A" name="Пересчитать статус"/>
    <bpmn:sendTask id="Task_Notify_A" name="Уведомить о причине и результате"/>
    <bpmn:endEvent id="End_NotApplicable_A" name="Антимотивация не применяется"/>
    <bpmn:endEvent id="End_NotDue_A" name="Списание не требуется"/>
    <bpmn:endEvent id="End_Deducted_A" name="Баллы / статус обновлены"/>

    <bpmn:sequenceFlow id="F_A_1" sourceRef="Start_Submit_A" targetRef="Task_Moderate_A"/>
    <bpmn:sequenceFlow id="F_A_2" sourceRef="Task_Moderate_A" targetRef="Gw_Accepted_A"/>
    <bpmn:sequenceFlow id="F_A_3N" name="Нет" sourceRef="Gw_Accepted_A" targetRef="Task_Reject_A"/>
    <bpmn:sequenceFlow id="F_A_4N" sourceRef="Task_Reject_A" targetRef="End_Rejected_A"/>
    <bpmn:sequenceFlow id="F_A_3Y" name="Да" sourceRef="Gw_Accepted_A" targetRef="Task_Award_A"/>
    <bpmn:sequenceFlow id="F_A_4Y" sourceRef="Task_Award_A" targetRef="Task_RecordActivity_A"/>
    <bpmn:sequenceFlow id="F_A_5Y" sourceRef="Task_RecordActivity_A" targetRef="Task_RecalcEarned_A"/>
    <bpmn:sequenceFlow id="F_A_6Y" sourceRef="Task_RecalcEarned_A" targetRef="End_Activity_A"/>

    <bpmn:sequenceFlow id="F_A_10" sourceRef="Start_Check_A" targetRef="Task_RequestASUP_A"/>
    <bpmn:sequenceFlow id="F_A_11" sourceRef="Task_RequestASUP_A" targetRef="Task_ReceiveASUP_A"/>
    <bpmn:sequenceFlow id="F_A_12" sourceRef="Task_ReceiveASUP_A" targetRef="Task_CalcInactivity_A"/>
    <bpmn:sequenceFlow id="F_A_13" sourceRef="Task_CalcInactivity_A" targetRef="Gw_CurrentAbsence_A"/>
    <bpmn:sequenceFlow id="F_A_14Y" name="Да" sourceRef="Gw_CurrentAbsence_A" targetRef="End_Paused_A"/>
    <bpmn:sequenceFlow id="F_A_14N" name="Нет" sourceRef="Gw_CurrentAbsence_A" targetRef="Gw_Level_A"/>
    <bpmn:sequenceFlow id="F_A_15N" name="Нет" sourceRef="Gw_Level_A" targetRef="End_NotApplicable_A"/>
    <bpmn:sequenceFlow id="F_A_15Y" name="Да" sourceRef="Gw_Level_A" targetRef="Gw_Threshold_A"/>
    <bpmn:sequenceFlow id="F_A_16N" name="Нет" sourceRef="Gw_Threshold_A" targetRef="End_NotDue_A"/>
    <bpmn:sequenceFlow id="F_A_16Y" name="Да" sourceRef="Gw_Threshold_A" targetRef="Gw_Due_A"/>
    <bpmn:sequenceFlow id="F_A_17N" name="Нет" sourceRef="Gw_Due_A" targetRef="End_NotDue_A"/>
    <bpmn:sequenceFlow id="F_A_17Y" name="Да" sourceRef="Gw_Due_A" targetRef="Task_Deduct_A"/>
    <bpmn:sequenceFlow id="F_A_18" sourceRef="Task_Deduct_A" targetRef="Task_RecalcAfterDeduct_A"/>
    <bpmn:sequenceFlow id="F_A_19" sourceRef="Task_RecalcAfterDeduct_A" targetRef="Task_Notify_A"/>
    <bpmn:sequenceFlow id="F_A_20" sourceRef="Task_Notify_A" targetRef="End_Deducted_A"/>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_A">
    <bpmndi:BPMNPlane id="Plane_A" bpmnElement="Collab_TOBE_A">
      <bpmndi:BPMNShape id="Participant_User_A_di" bpmnElement="Participant_User_A" isHorizontal="true"><dc:Bounds x="40" y="30" width="2500" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_BIO_A_di" bpmnElement="Participant_BIO_A" isHorizontal="true"><dc:Bounds x="40" y="140" width="2500" height="500"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Moderation_A_di" bpmnElement="Lane_Moderation_A" isHorizontal="true"><dc:Bounds x="70" y="140" width="2470" height="190"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Progress_A_di" bpmnElement="Lane_Progress_A" isHorizontal="true"><dc:Bounds x="70" y="330" width="2470" height="310"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_ASUP_A_di" bpmnElement="Participant_ASUP_A" isHorizontal="true"><dc:Bounds x="40" y="675" width="2500" height="80"/></bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Start_Submit_A_di" bpmnElement="Start_Submit_A"><dc:Bounds x="120" y="215" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Moderate_A_di" bpmnElement="Task_Moderate_A"><dc:Bounds x="220" y="190" width="150" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Accepted_A_di" bpmnElement="Gw_Accepted_A" isMarkerVisible="true"><dc:Bounds x="445" y="205" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Reject_A_di" bpmnElement="Task_Reject_A"><dc:Bounds x="575" y="165" width="140" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Rejected_A_di" bpmnElement="End_Rejected_A"><dc:Bounds x="790" y="182" width="36" height="36"/></bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_Award_A_di" bpmnElement="Task_Award_A"><dc:Bounds x="575" y="365" width="140" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RecordActivity_A_di" bpmnElement="Task_RecordActivity_A"><dc:Bounds x="790" y="365" width="190" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RecalcEarned_A_di" bpmnElement="Task_RecalcEarned_A"><dc:Bounds x="1055" y="365" width="145" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Activity_A_di" bpmnElement="End_Activity_A"><dc:Bounds x="1270" y="382" width="36" height="36"/></bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Start_Check_A_di" bpmnElement="Start_Check_A"><dc:Bounds x="120" y="530" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RequestASUP_A_di" bpmnElement="Task_RequestASUP_A"><dc:Bounds x="220" y="505" width="170" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ReceiveASUP_A_di" bpmnElement="Task_ReceiveASUP_A"><dc:Bounds x="465" y="505" width="165" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CalcInactivity_A_di" bpmnElement="Task_CalcInactivity_A"><dc:Bounds x="705" y="495" width="210" height="90"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_CurrentAbsence_A_di" bpmnElement="Gw_CurrentAbsence_A" isMarkerVisible="true"><dc:Bounds x="990" y="515" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Paused_A_di" bpmnElement="End_Paused_A"><dc:Bounds x="1085" y="590" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Level_A_di" bpmnElement="Gw_Level_A" isMarkerVisible="true"><dc:Bounds x="1120" y="515" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_NotApplicable_A_di" bpmnElement="End_NotApplicable_A"><dc:Bounds x="1210" y="590" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Threshold_A_di" bpmnElement="Gw_Threshold_A" isMarkerVisible="true"><dc:Bounds x="1250" y="515" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Due_A_di" bpmnElement="Gw_Due_A" isMarkerVisible="true"><dc:Bounds x="1390" y="515" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_NotDue_A_di" bpmnElement="End_NotDue_A"><dc:Bounds x="1460" y="590" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Deduct_A_di" bpmnElement="Task_Deduct_A"><dc:Bounds x="1515" y="505" width="200" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RecalcAfterDeduct_A_di" bpmnElement="Task_RecalcAfterDeduct_A"><dc:Bounds x="1790" y="505" width="150" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Notify_A_di" bpmnElement="Task_Notify_A"><dc:Bounds x="2015" y="505" width="180" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Deducted_A_di" bpmnElement="End_Deducted_A"><dc:Bounds x="2270" y="522" width="36" height="36"/></bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="F_A_1_di" bpmnElement="F_A_1"><di:waypoint x="156" y="233"/><di:waypoint x="220" y="230"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_A_2_di" bpmnElement="F_A_2"><di:waypoint x="370" y="230"/><di:waypoint x="445" y="230"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_A_3N_di" bpmnElement="F_A_3N"><di:waypoint x="470" y="205"/><di:waypoint x="470" y="200"/><di:waypoint x="575" y="200"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_A_4N_di" bpmnElement="F_A_4N"><di:waypoint x="715" y="200"/><di:waypoint x="790" y="200"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_A_3Y_di" bpmnElement="F_A_3Y"><di:waypoint x="470" y="255"/><di:waypoint x="470" y="400"/><di:waypoint x="575" y="400"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_A_4Y_di" bpmnElement="F_A_4Y"><di:waypoint x="715" y="400"/><di:waypoint x="790" y="400"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_A_5Y_di" bpmnElement="F_A_5Y"><di:waypoint x="980" y="400"/><di:waypoint x="1055" y="400"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_A_6Y_di" bpmnElement="F_A_6Y"><di:waypoint x="1200" y="400"/><di:waypoint x="1270" y="400"/></bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="F_A_10_di" bpmnElement="F_A_10"><di:waypoint x="156" y="548"/><di:waypoint x="220" y="540"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_A_11_di" bpmnElement="F_A_11"><di:waypoint x="390" y="540"/><di:waypoint x="465" y="540"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_A_12_di" bpmnElement="F_A_12"><di:waypoint x="630" y="540"/><di:waypoint x="705" y="540"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_A_13_di" bpmnElement="F_A_13"><di:waypoint x="915" y="540"/><di:waypoint x="990" y="540"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_A_14Y_di" bpmnElement="F_A_14Y"><di:waypoint x="1015" y="565"/><di:waypoint x="1015" y="608"/><di:waypoint x="1085" y="608"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_A_14N_di" bpmnElement="F_A_14N"><di:waypoint x="1040" y="540"/><di:waypoint x="1120" y="540"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_A_15N_di" bpmnElement="F_A_15N"><di:waypoint x="1145" y="565"/><di:waypoint x="1145" y="608"/><di:waypoint x="1210" y="608"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_A_15Y_di" bpmnElement="F_A_15Y"><di:waypoint x="1170" y="540"/><di:waypoint x="1250" y="540"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_A_16N_di" bpmnElement="F_A_16N"><di:waypoint x="1275" y="565"/><di:waypoint x="1275" y="608"/><di:waypoint x="1460" y="608"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_A_16Y_di" bpmnElement="F_A_16Y"><di:waypoint x="1300" y="540"/><di:waypoint x="1390" y="540"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_A_17N_di" bpmnElement="F_A_17N"><di:waypoint x="1415" y="565"/><di:waypoint x="1415" y="608"/><di:waypoint x="1460" y="608"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_A_17Y_di" bpmnElement="F_A_17Y"><di:waypoint x="1440" y="540"/><di:waypoint x="1515" y="540"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_A_18_di" bpmnElement="F_A_18"><di:waypoint x="1715" y="540"/><di:waypoint x="1790" y="540"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_A_19_di" bpmnElement="F_A_19"><di:waypoint x="1940" y="540"/><di:waypoint x="2015" y="540"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_A_20_di" bpmnElement="F_A_20"><di:waypoint x="2195" y="540"/><di:waypoint x="2270" y="540"/></bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="MF_Submit_A_di" bpmnElement="MF_Submit_A"><di:waypoint x="138" y="110"/><di:waypoint x="138" y="215"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MF_Notify_A_di" bpmnElement="MF_Notify_A"><di:waypoint x="2105" y="505"/><di:waypoint x="2105" y="110"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MF_ASUP_Request_A_di" bpmnElement="MF_ASUP_Request_A"><di:waypoint x="305" y="575"/><di:waypoint x="305" y="675"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MF_ASUP_Response_A_di" bpmnElement="MF_ASUP_Response_A"><di:waypoint x="548" y="675"/><di:waypoint x="548" y="575"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
