<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_KGMK_ProjectSelection" targetNamespace="https://sergeygalay.github.io/bpmn-editor/kgmk-project-selection-request">
  <bpmn:collaboration id="Collaboration_ProjectSelection">
    <bpmn:participant id="Participant_StoreB" name="Магазин проектов" processRef="Process_ProjectSelection"/>
    <bpmn:participant id="Participant_BotB" name="eXpress / бот"/>
    <bpmn:messageFlow id="Message_RequestToBot" name="submit_project_request" sourceRef="Task_SendBot" targetRef="Participant_BotB"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_ProjectSelection" name="Выбор и отправка инициатив на внедрение" isExecutable="false">
    <bpmn:laneSet id="LaneSet_B">
      <bpmn:lane id="Lane_Manager" name="Руководитель ПБиОТ площадки">
        <bpmn:flowNodeRef>Start_Select</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Browse</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Add</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_More</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Review</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Submit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Магазин проектов / система">
        <bpmn:flowNodeRef>Task_Context</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_CanSelect</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ViewOnly</bpmn:flowNodeRef><bpmn:flowNodeRef>End_View</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Catalog</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Allowed</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Reject</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_NotEmpty</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Revalidate</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Remain</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Block</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Express</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_SendBot</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_BotOK</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_MarkSent</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_LocalFallback</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_WebSave</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Request</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Select" name="Пользователь открыл магазин"/>
    <bpmn:serviceTask id="Task_Context" name="Определить профиль, роль, площадку, закреплённый контур и состояние кампании"/>
    <bpmn:exclusiveGateway id="Gateway_CanSelect" name="Руководитель ПБиОТ, площадка в контуре и окно открыто?"/>
    <bpmn:serviceTask id="Task_ViewOnly" name="Включить режим просмотра и показать причину"/>
    <bpmn:endEvent id="End_View" name="Выбор недоступен"/>
    <bpmn:serviceTask id="Task_Catalog" name="Получить уровень площадки и сформировать каталог: текущий уровень + следующий шаг"/>
    <bpmn:userTask id="Task_Browse" name="Просмотреть каталог, поиск, категории и карточки инициатив"/>
    <bpmn:userTask id="Task_Add" name="Выбрать инициативу и добавить в текущую заявку"/>
    <bpmn:exclusiveGateway id="Gateway_Allowed" name="Инициатива разрешена уровнем?"/>
    <bpmn:serviceTask id="Task_Reject" name="Не добавлять инициативу и показать сообщение"/>
    <bpmn:exclusiveGateway id="Gateway_More" name="Добавить ещё инициативы?"/>
    <bpmn:userTask id="Task_Review" name="Открыть «Мои заявки», проверить состав и при необходимости удалить инициативы"/>
    <bpmn:userTask id="Task_Submit" name="Нажать «Отправить заявку на внедрение»"/>
    <bpmn:exclusiveGateway id="Gateway_NotEmpty" name="Заявка непустая?"/>
    <bpmn:serviceTask id="Task_Revalidate" name="Повторно проверить инициативы по разрешённому набору"/>
    <bpmn:exclusiveGateway id="Gateway_Remain" name="После проверки есть разрешённые инициативы?"/>
    <bpmn:serviceTask id="Task_Block" name="Блокировать отправку и показать причину"/>
    <bpmn:exclusiveGateway id="Gateway_Express" name="Работа внутри eXpress?"/>
    <bpmn:serviceTask id="Task_SendBot" name="Передать заявку в бот"/>
    <bpmn:exclusiveGateway id="Gateway_BotOK" name="Бот ответил успешно?"/>
    <bpmn:serviceTask id="Task_MarkSent" name="Перенести инициативы в отправленные и очистить текущую заявку"/>
    <bpmn:serviceTask id="Task_LocalFallback" name="Сохранить локально, очистить заявку и сообщить, что бот не ответил"/>
    <bpmn:serviceTask id="Task_WebSave" name="Сохранить заявку локально в web-demo и очистить текущую заявку"/>
    <bpmn:endEvent id="End_Request" name="Заявка зафиксирована"/>
    <bpmn:sequenceFlow id="F01" sourceRef="Start_Select" targetRef="Task_Context"/>
    <bpmn:sequenceFlow id="F02" sourceRef="Task_Context" targetRef="Gateway_CanSelect"/>
    <bpmn:sequenceFlow id="F03" name="Да" sourceRef="Gateway_CanSelect" targetRef="Task_Catalog"/>
    <bpmn:sequenceFlow id="F04" name="Нет" sourceRef="Gateway_CanSelect" targetRef="Task_ViewOnly"/>
    <bpmn:sequenceFlow id="F05" sourceRef="Task_ViewOnly" targetRef="End_View"/>
    <bpmn:sequenceFlow id="F06" sourceRef="Task_Catalog" targetRef="Task_Browse"/>
    <bpmn:sequenceFlow id="F07" sourceRef="Task_Browse" targetRef="Task_Add"/>
    <bpmn:sequenceFlow id="F08" sourceRef="Task_Add" targetRef="Gateway_Allowed"/>
    <bpmn:sequenceFlow id="F09" name="Да" sourceRef="Gateway_Allowed" targetRef="Gateway_More"/>
    <bpmn:sequenceFlow id="F10" name="Нет" sourceRef="Gateway_Allowed" targetRef="Task_Reject"/>
    <bpmn:sequenceFlow id="F11" sourceRef="Task_Reject" targetRef="Task_Browse"/>
    <bpmn:sequenceFlow id="F12" name="Да" sourceRef="Gateway_More" targetRef="Task_Browse"/>
    <bpmn:sequenceFlow id="F13" name="Нет" sourceRef="Gateway_More" targetRef="Task_Review"/>
    <bpmn:sequenceFlow id="F14" sourceRef="Task_Review" targetRef="Task_Submit"/>
    <bpmn:sequenceFlow id="F15" sourceRef="Task_Submit" targetRef="Gateway_NotEmpty"/>
    <bpmn:sequenceFlow id="F16" name="Да" sourceRef="Gateway_NotEmpty" targetRef="Task_Revalidate"/>
    <bpmn:sequenceFlow id="F17" name="Нет" sourceRef="Gateway_NotEmpty" targetRef="Task_Block"/>
    <bpmn:sequenceFlow id="F18" sourceRef="Task_Revalidate" targetRef="Gateway_Remain"/>
    <bpmn:sequenceFlow id="F19" name="Да" sourceRef="Gateway_Remain" targetRef="Gateway_Express"/>
    <bpmn:sequenceFlow id="F20" name="Нет" sourceRef="Gateway_Remain" targetRef="Task_Block"/>
    <bpmn:sequenceFlow id="F21" sourceRef="Task_Block" targetRef="Task_Review"/>
    <bpmn:sequenceFlow id="F22" name="Да" sourceRef="Gateway_Express" targetRef="Task_SendBot"/>
    <bpmn:sequenceFlow id="F23" name="Нет" sourceRef="Gateway_Express" targetRef="Task_WebSave"/>
    <bpmn:sequenceFlow id="F24" sourceRef="Task_SendBot" targetRef="Gateway_BotOK"/>
    <bpmn:sequenceFlow id="F25" name="Да" sourceRef="Gateway_BotOK" targetRef="Task_MarkSent"/>
    <bpmn:sequenceFlow id="F26" name="Нет" sourceRef="Gateway_BotOK" targetRef="Task_LocalFallback"/>
    <bpmn:sequenceFlow id="F27" sourceRef="Task_MarkSent" targetRef="End_Request"/>
    <bpmn:sequenceFlow id="F28" sourceRef="Task_LocalFallback" targetRef="End_Request"/>
    <bpmn:sequenceFlow id="F29" sourceRef="Task_WebSave" targetRef="End_Request"/>
    <bpmn:textAnnotation id="Annotation_Fallback"><bpmn:text>Прототип показывает локально сохранённые инициативы как «Отправлено». Целевой статус, retry и дедупликация требуют согласования.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_Fallback" sourceRef="Task_LocalFallback" targetRef="Annotation_Fallback"/>
    <bpmn:textAnnotation id="Annotation_Window"><bpmn:text>В наблюдаемой конфигурации прототипа окно кампании: 01.09.2026–30.09.2026 (МСК). Даты являются конфигурацией.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_Window" sourceRef="Gateway_CanSelect" targetRef="Annotation_Window"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_ProjectSelection">
    <bpmndi:BPMNPlane id="Plane_ProjectSelection" bpmnElement="Collaboration_ProjectSelection">
      <bpmndi:BPMNShape id="Participant_StoreB_di" bpmnElement="Participant_StoreB" isHorizontal="true"><dc:Bounds x="30" y="40" width="3700" height="430"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Manager_di" bpmnElement="Lane_Manager" isHorizontal="true"><dc:Bounds x="60" y="40" width="3670" height="180"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_System_di" bpmnElement="Lane_System" isHorizontal="true"><dc:Bounds x="60" y="220" width="3670" height="250"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_BotB_di" bpmnElement="Participant_BotB" isHorizontal="true"><dc:Bounds x="2890" y="540" width="540" height="90"/></bpmndi:BPMNShape>
