<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
 xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
 id="Definitions_BIO_TOBE_B" targetNamespace="https://sergeygalay.github.io/bpmn-editor/bio-antimotivation-to-be-b">
  <bpmn:collaboration id="Collab_TOBE_B">
    <bpmn:participant id="Participant_User_B" name="Пользователь" />
    <bpmn:participant id="Participant_BIO_B" name="БИО" processRef="Process_BIO_B" />
    <bpmn:messageFlow id="MF_Submit_B" name="Зарегистрированная опасность" sourceRef="Participant_User_B" targetRef="Start_Submit_B" />
    <bpmn:messageFlow id="MF_Notify_B" name="Текущая позиция / статус" sourceRef="Task_Notify_B" targetRef="Participant_User_B" />
  </bpmn:collaboration>

  <bpmn:process id="Process_BIO_B" name="TO BE B — Ограниченный Топ-рейтинг" isExecutable="false">
    <bpmn:laneSet id="LaneSet_B">
      <bpmn:lane id="Lane_Moderation_B" name="Модерация">
        <bpmn:flowNodeRef>Start_Submit_B</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Moderate_B</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Accepted_B</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Reject_B</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected_B</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Rating_B" name="Рейтинг и статусы">
        <bpmn:flowNodeRef>Task_Award_B</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_Recalc_B</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecalcRating_B</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_TopN_B</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SetKeeper_B</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SetRegularStatus_B</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Notify_B</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rating_B</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_Submit_B" name="Опасность зарегистрирована"><bpmn:messageEventDefinition id="MED_Submit_B"/></bpmn:startEvent>
    <bpmn:userTask id="Task_Moderate_B" name="Проверить опасность"/>
    <bpmn:exclusiveGateway id="Gw_Accepted_B" name="Опасность подтверждена?"/>
    <bpmn:serviceTask id="Task_Reject_B" name="Отклонить заявку"/>
    <bpmn:endEvent id="End_Rejected_B" name="Баллы не начислены"/>
    <bpmn:serviceTask id="Task_Award_B" name="Начислить баллы"/>

    <bpmn:startEvent id="Start_Recalc_B" name="Плановый пересчет рейтинга"><bpmn:timerEventDefinition id="TED_Recalc_B"/></bpmn:startEvent>
    <bpmn:serviceTask id="Task_RecalcRating_B" name="Пересчитать корпоративный рейтинг"/>
    <bpmn:exclusiveGateway id="Gw_TopN_B" name="Пользователь входит в Топ-N?"/>
    <bpmn:serviceTask id="Task_SetKeeper_B" name="Назначить / сохранить статус «Хранитель»"/>
    <bpmn:serviceTask id="Task_SetRegularStatus_B" name="Установить статус по обычному порогу баллов"/>
    <bpmn:sendTask id="Task_Notify_B" name="Показать позицию и статус"/>
    <bpmn:endEvent id="End_Rating_B" name="Рейтинг актуализирован"/>

    <bpmn:sequenceFlow id="F_B_1" sourceRef="Start_Submit_B" targetRef="Task_Moderate_B"/>
    <bpmn:sequenceFlow id="F_B_2" sourceRef="Task_Moderate_B" targetRef="Gw_Accepted_B"/>
    <bpmn:sequenceFlow id="F_B_3N" name="Нет" sourceRef="Gw_Accepted_B" targetRef="Task_Reject_B"/>
    <bpmn:sequenceFlow id="F_B_4N" sourceRef="Task_Reject_B" targetRef="End_Rejected_B"/>
    <bpmn:sequenceFlow id="F_B_3Y" name="Да" sourceRef="Gw_Accepted_B" targetRef="Task_Award_B"/>
    <bpmn:sequenceFlow id="F_B_4Y" sourceRef="Task_Award_B" targetRef="Task_RecalcRating_B"/>
    <bpmn:sequenceFlow id="F_B_10" sourceRef="Start_Recalc_B" targetRef="Task_RecalcRating_B"/>
    <bpmn:sequenceFlow id="F_B_11" sourceRef="Task_RecalcRating_B" targetRef="Gw_TopN_B"/>
    <bpmn:sequenceFlow id="F_B_12Y" name="Да" sourceRef="Gw_TopN_B" targetRef="Task_SetKeeper_B"/>
    <bpmn:sequenceFlow id="F_B_12N" name="Нет" sourceRef="Gw_TopN_B" targetRef="Task_SetRegularStatus_B"/>
    <bpmn:sequenceFlow id="F_B_13Y" sourceRef="Task_SetKeeper_B" targetRef="Task_Notify_B"/>
    <bpmn:sequenceFlow id="F_B_13N" sourceRef="Task_SetRegularStatus_B" targetRef="Task_Notify_B"/>
    <bpmn:sequenceFlow id="F_B_14" sourceRef="Task_Notify_B" targetRef="End_Rating_B"/>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_B">
    <bpmndi:BPMNPlane id="Plane_B" bpmnElement="Collab_TOBE_B">
      <bpmndi:BPMNShape id="Participant_User_B_di" bpmnElement="Participant_User_B" isHorizontal="true"><dc:Bounds x="40" y="30" width="1900" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_BIO_B_di" bpmnElement="Participant_BIO_B" isHorizontal="true"><dc:Bounds x="40" y="140" width="1900" height="420"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Moderation_B_di" bpmnElement="Lane_Moderation_B" isHorizontal="true"><dc:Bounds x="70" y="140" width="1870" height="190"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Rating_B_di" bpmnElement="Lane_Rating_B" isHorizontal="true"><dc:Bounds x="70" y="330" width="1870" height="230"/></bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Start_Submit_B_di" bpmnElement="Start_Submit_B"><dc:Bounds x="120" y="215" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Moderate_B_di" bpmnElement="Task_Moderate_B"><dc:Bounds x="220" y="190" width="150" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Accepted_B_di" bpmnElement="Gw_Accepted_B" isMarkerVisible="true"><dc:Bounds x="445" y="205" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Reject_B_di" bpmnElement="Task_Reject_B"><dc:Bounds x="575" y="165" width="140" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Rejected_B_di" bpmnElement="End_Rejected_B"><dc:Bounds x="790" y="182" width="36" height="36"/></bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_Award_B_di" bpmnElement="Task_Award_B"><dc:Bounds x="575" y="365" width="140" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Recalc_B_di" bpmnElement="Start_Recalc_B"><dc:Bounds x="120" y="445" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RecalcRating_B_di" bpmnElement="Task_RecalcRating_B"><dc:Bounds x="790" y="365" width="185" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_TopN_B_di" bpmnElement="Gw_TopN_B" isMarkerVisible="true"><dc:Bounds x="1050" y="375" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SetKeeper_B_di" bpmnElement="Task_SetKeeper_B"><dc:Bounds x="1175" y="345" width="190" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SetRegularStatus_B_di" bpmnElement="Task_SetRegularStatus_B"><dc:Bounds x="1175" y="455" width="205" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Notify_B_di" bpmnElement="Task_Notify_B"><dc:Bounds x="1460" y="385" width="165" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Rating_B_di" bpmnElement="End_Rating_B"><dc:Bounds x="1700" y="402" width="36" height="36"/></bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="F_B_1_di" bpmnElement="F_B_1"><di:waypoint x="156" y="233"/><di:waypoint x="220" y="230"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_B_2_di" bpmnElement="F_B_2"><di:waypoint x="370" y="230"/><di:waypoint x="445" y="230"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_B_3N_di" bpmnElement="F_B_3N"><di:waypoint x="470" y="205"/><di:waypoint x="470" y="200"/><di:waypoint x="575" y="200"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_B_4N_di" bpmnElement="F_B_4N"><di:waypoint x="715" y="200"/><di:waypoint x="790" y="200"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_B_3Y_di" bpmnElement="F_B_3Y"><di:waypoint x="470" y="255"/><di:waypoint x="470" y="400"/><di:waypoint x="575" y="400"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_B_4Y_di" bpmnElement="F_B_4Y"><di:waypoint x="715" y="400"/><di:waypoint x="790" y="400"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_B_10_di" bpmnElement="F_B_10"><di:waypoint x="156" y="463"/><di:waypoint x="700" y="463"/><di:waypoint x="700" y="400"/><di:waypoint x="790" y="400"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_B_11_di" bpmnElement="F_B_11"><di:waypoint x="975" y="400"/><di:waypoint x="1050" y="400"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_B_12Y_di" bpmnElement="F_B_12Y"><di:waypoint x="1075" y="375"/><di:waypoint x="1075" y="380"/><di:waypoint x="1175" y="380"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_B_12N_di" bpmnElement="F_B_12N"><di:waypoint x="1075" y="425"/><di:waypoint x="1075" y="490"/><di:waypoint x="1175" y="490"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_B_13Y_di" bpmnElement="F_B_13Y"><di:waypoint x="1365" y="380"/><di:waypoint x="1410" y="380"/><di:waypoint x="1410" y="420"/><di:waypoint x="1460" y="420"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_B_13N_di" bpmnElement="F_B_13N"><di:waypoint x="1380" y="490"/><di:waypoint x="1410" y="490"/><di:waypoint x="1410" y="420"/><di:waypoint x="1460" y="420"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_B_14_di" bpmnElement="F_B_14"><di:waypoint x="1625" y="420"/><di:waypoint x="1700" y="420"/></bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="MF_Submit_B_di" bpmnElement="MF_Submit_B"><di:waypoint x="138" y="110"/><di:waypoint x="138" y="215"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MF_Notify_B_di" bpmnElement="MF_Notify_B"><di:waypoint x="1542" y="385"/><di:waypoint x="1542" y="110"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
