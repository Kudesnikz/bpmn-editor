<?xml version="1.0" encoding="UTF-8"?><bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_KGMK_Culture_Assessment" targetNamespace="https://sergeygalay.github.io/bpmn-editor/kgmk-culture-assessment-publication"><bpmn:collaboration id="Collaboration_CultureAssessment"><bpmn:participant id="Participant_StoreA" name="Магазин проектов" processRef="Process_CultureAssessment" /><bpmn:participant id="Participant_BotA" name="eXpress / бот" /><bpmn:messageFlow id="Message_AssessmentToBot" name="publish_culture_assessment" sourceRef="Task_PublishBot" targetRef="Participant_BotA" /></bpmn:collaboration><bpmn:process id="Process_CultureAssessment" name="Публикация годового замера культуры по всем БЕ" isExecutable="false"><bpmn:laneSet id="LaneSet_A"><bpmn:lane id="Lane_CorporatePBIOT" name="Корпоративный ПБиОТ"><bpmn:flowNodeRef>Start_Assessment</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_OpenAssessment</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_InputAssessment</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ConfirmOverwrite</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_StoreSystemA" name="Магазин проектов / система"><bpmn:flowNodeRef>Task_ShowCurrent</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Parse</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Parsed</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_AllBE</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_UnknownBE</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_YearValid</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_SameYear</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Overwrite</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_FixOfficial</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Archive</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Express</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_PublishBot</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_BotOK</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ShowSuccessBot</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ShowLocal</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ShowSuccessWeb</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Assessment</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ShowError</bpmn:flowNodeRef><bpmn:flowNodeRef>End_AssessmentError</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="Start_Assessment" name="Годовой замер завершён" /><bpmn:userTask id="Task_OpenAssessment" name="Открыть раздел «Замер культуры»" /><bpmn:serviceTask id="Task_ShowCurrent" name="Показать текущий замер и перечень БЕ" /><bpmn:userTask id="Task_InputAssessment" name="Указать год/дату и предоставить CSV/JSON или таблицу" /><bpmn:serviceTask id="Task_Parse" name="Разобрать данные и сопоставить БЕ и уровни" /><bpmn:exclusiveGateway id="Gateway_Parsed" name="Данные разобраны?" /><bpmn:exclusiveGateway id="Gateway_AllBE" name="Есть уровни для всех БЕ?" /><bpmn:exclusiveGateway id="Gateway_UnknownBE" name="Есть неизвестные БЕ?" /><bpmn:exclusiveGateway id="Gateway_YearValid" name="Год допустим и не меньше действующего?" /><bpmn:exclusiveGateway id="Gateway_SameYear" name="Замер этого года уже существует?" /><bpmn:userTask id="Task_ConfirmOverwrite" name="Подтвердить перезапись замера этого года" /><bpmn:exclusiveGateway id="Gateway_Overwrite" name="Перезапись подтверждена?" /><bpmn:serviceTask id="Task_FixOfficial" name="Зафиксировать уровни БЕ как official и сформировать campaign" /><bpmn:serviceTask id="Task_Archive" name="Перенести предыдущий замер другого года в архив" /><bpmn:exclusiveGateway id="Gateway_Express" name="Работа внутри eXpress?" /><bpmn:serviceTask id="Task_PublishBot" name="Передать замер в бот" /><bpmn:exclusiveGateway id="Gateway_BotOK" name="Бот ответил успешно?" /><bpmn:serviceTask id="Task_ShowSuccessBot" name="Показать подтверждение фиксации и отправки" /><bpmn:serviceTask id="Task_ShowLocal" name="Сообщить: замер сохранён локально, бот не ответил" /><bpmn:serviceTask id="Task_ShowSuccessWeb" name="Показать подтверждение локальной фиксации" /><bpmn:endEvent id="End_Assessment" name="Уровни БЕ зафиксированы и влияют на каталог" /><bpmn:serviceTask id="Task_ShowError" name="Показать причину ошибки" /><bpmn:endEvent id="End_AssessmentError" name="Замер не зафиксирован" /><bpmn:sequenceFlow id="Flow_A01" sourceRef="Start_Assessment" targetRef="Task_OpenAssessment" /><bpmn:sequenceFlow id="Flow_A02" sourceRef="Task_OpenAssessment" targetRef="Task_ShowCurrent" /><bpmn:sequenceFlow id="Flow_A03" sourceRef="Task_ShowCurrent" targetRef="Task_InputAssessment" /><bpmn:sequenceFlow id="Flow_A04" sourceRef="Task_InputAssessment" targetRef="Task_Parse" /><bpmn:sequenceFlow id="Flow_A05" sourceRef="Task_Parse" targetRef="Gateway_Parsed" /><bpmn:sequenceFlow id="Flow_A06" sourceRef="Gateway_Parsed" targetRef="Gateway_AllBE" name="Да" /><bpmn:sequenceFlow id="Flow_A07" sourceRef="Gateway_Parsed" targetRef="Task_ShowError" name="Нет: файл пустой / формат не разобран" /><bpmn:sequenceFlow id="Flow_A08" sourceRef="Gateway_AllBE" targetRef="Gateway_UnknownBE" name="Да" /><bpmn:sequenceFlow id="Flow_A09" sourceRef="Gateway_AllBE" targetRef="Task_ShowError" name="Нет" /><bpmn:sequenceFlow id="Flow_A10" sourceRef="Gateway_UnknownBE" targetRef="Task_ShowError" name="Да" /><bpmn:sequenceFlow id="Flow_A11" sourceRef="Gateway_UnknownBE" targetRef="Gateway_YearValid" name="Нет" /><bpmn:sequenceFlow id="Flow_A12" sourceRef="Gateway_YearValid" targetRef="Gateway_SameYear" name="Да" /><bpmn:sequenceFlow id="Flow_A13" sourceRef="Gateway_YearValid" targetRef="Task_ShowError" name="Нет" /><bpmn:sequenceFlow id="Flow_A14" sourceRef="Gateway_SameYear" targetRef="Task_ConfirmOverwrite" name="Да" /><bpmn:sequenceFlow id="Flow_A15" sourceRef="Gateway_SameYear" targetRef="Task_FixOfficial" name="Нет" /><bpmn:sequenceFlow id="Flow_A16" sourceRef="Task_ConfirmOverwrite" targetRef="Gateway_Overwrite" /><bpmn:sequenceFlow id="Flow_A17" sourceRef="Gateway_Overwrite" targetRef="Task_FixOfficial" name="Да" /><bpmn