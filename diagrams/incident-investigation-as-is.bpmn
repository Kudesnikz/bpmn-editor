<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Incident_ASIS" targetNamespace="https://sergeygalay.github.io/bpmn-editor/incident-investigation-as-is">
  <bpmn:collaboration id="Collaboration_Incident_ASIS">
    <bpmn:participant id="Participant_Company_ASIS" name="Компания" processRef="Process_Incident_ASIS" />
    <bpmn:participant id="Participant_Med_ASIS" name="Медицинская организация" />
    <bpmn:participant id="Participant_Gov_ASIS" name="Государственные / надзорные органы" />
    <bpmn:messageFlow id="Message_ASIS_MedHelp" name="Медицинская помощь / первичные данные" sourceRef="Task_Report_ASIS" targetRef="Participant_Med_ASIS" />
    <bpmn:messageFlow id="Message_ASIS_315U" name="315У / уточнение категории" sourceRef="Participant_Med_ASIS" targetRef="Task_Classify_ASIS" />
    <bpmn:messageFlow id="Message_ASIS_NotifyGov" name="Первичное уведомление" sourceRef="Task_Notify_ASIS" targetRef="Participant_Gov_ASIS" />
    <bpmn:messageFlow id="Message_ASIS_DocsGov" name="Комплект документов" sourceRef="Task_SendDocs_ASIS" targetRef="Participant_Gov_ASIS" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Incident_ASIS" name="Расследование происшествия — AS IS" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Incident_ASIS">
      <bpmn:lane id="Lane_Employee_ASIS" name="Сотрудник / мастер / диспетчер">
        <bpmn:flowNodeRef>StartEvent_ASIS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Report_ASIS</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PBIOT_ASIS" name="ПБиОТ / расследователь">
        <bpmn:flowNodeRef>Task_Classify_ASIS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Notify_ASIS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Notify_ASIS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_NotifyMerge_ASIS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Commission_ASIS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Collect_ASIS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CollectAdditional_ASIS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Approve_ASIS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendDocs_ASIS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Control_ASIS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ASIS</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Commission_ASIS" name="Комиссия / профильные эксперты">
        <bpmn:flowNodeRef>Gateway_InvestigationMerge_ASIS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Investigate_ASIS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_InvestigationEnough_ASIS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DocMerge_ASIS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Docs_ASIS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Sign_ASIS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DocsApproved_ASIS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReworkDocs_ASIS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Actions_ASIS</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Leadership_ASIS" name="Руководство / ответственные за КД">
        <bpmn:flowNodeRef>Task_Execute_ASIS</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_ASIS" name="Происшествие" />
    <bpmn:userTask id="Task_Report_ASIS" name="Сообщить &#10;мастеру / диспетчеру и организовать первичное реагирование" />
    <bpmn:userTask id="Task_Classify_ASIS" name="Уточнить факты &#10;и классифицировать; при поступлении 315У пересмотреть при необходимости" />
    <bpmn:exclusiveGateway id="Gateway_Notify_ASIS" name="Нужно уведомить внешние органы?" />
    <bpmn:sendTask id="Task_Notify_ASIS" name="Уведомить предусмотренные государственные органы" />
    <bpmn:exclusiveGateway id="Gateway_NotifyMerge_ASIS" />
    <bpmn:userTask id="Task_Commission_ASIS" name="Сформировать комиссию" />
    <bpmn:manualTask id="Task_Collect_ASIS" name="Собрать первичные материалы на месте" />
    <bpmn:exclusiveGateway id="Gateway_InvestigationMerge_ASIS" />
    <bpmn:userTask id="Task_Investigate_ASIS" name="Провести осмотр, опросы и анализ материалов" />
    <bpmn:exclusiveGateway id="Gateway_InvestigationEnough_ASIS" name="Материалов и выводов достаточно?" />
    <bpmn:manualTask id="Task_CollectAdditional_ASIS" name="Дособрать материалы / уточнения" />
    <bpmn:exclusiveGateway id="Gateway_DocMerge_ASIS" />
    <bpmn:manualTask id="Task_Docs_ASIS" name="Вручную подготовить Форму 5 / Н-1 / внутренний акт" />
    <bpmn:manualTask id="Task_Sign_ASIS" name="Предварительно согласовать, собрать подписи и комплекты документов" />
    <bpmn:exclusiveGateway id="Gateway_DocsApproved_ASIS" name="Документы согласованы?" />
    <bpmn:userTask id="Task_ReworkDocs_ASIS" name="Доработать документы / устранить замечания" />
    <bpmn:userTask id="Task_Approve_ASIS" name="Утвердить акт и ознакомить пострадавшего" />
    <bpmn:sendTask id="Task_SendDocs_ASIS" name="Направить документы в органы / архив" />
    <bpmn:userTask id="Task_Actions_ASIS" name="Сформировать корректирующие мероприятия" />
    <bpmn:userTask id="Task_Execute_ASIS" name="Исполнить корректирующие мероприятия" />
    <bpmn:userTask id="Task_Control_ASIS" name="Контролировать выполнение КД" />
    <bpmn:endEvent id="EndEvent_ASIS" name="Завершено" />
    <bpmn:sequenceFlow id="Flow_ASIS_F01" sourceRef="StartEvent_ASIS" targetRef="Task_Report_ASIS" />
    <bpmn:sequenceFlow id="Flow_ASIS_F02" sourceRef="Task_Report_ASIS" targetRef="Task_Classify_ASIS" />
    <bpmn:sequenceFlow id="Flow_ASIS_F03" sourceRef="Task_Classify_ASIS" targetRef="Gateway_Notify_ASIS" />
    <bpmn:sequenceFlow id="Flow_ASIS_F04" name="Да" sourceRef="Gateway_Notify_ASIS" targetRef="Task_Notify_ASIS" />
    <bpmn:sequenceFlow id="Flow_ASIS_F05" sourceRef="Task_Notify_ASIS" targetRef="Gateway_NotifyMerge_ASIS" />
    <bpmn:sequenceFlow id="Flow_ASIS_F06" name="Нет" sourceRef="Gateway_Notify_ASIS" targetRef="Gateway_NotifyMerge_ASIS" />
    <bpmn:sequenceFlow id="Flow_ASIS_F07" sourceRef="Gateway_NotifyMerge_ASIS" targetRef="Task_Commission_ASIS" />
    <bpmn:sequenceFlow id="Flow_ASIS_F08" sourceRef="Task_Commission_ASIS" targetRef="Task_Collect_ASIS" />
    <bpmn:sequenceFlow id="Flow_ASIS_F09" sourceRef="Task_Collect_ASIS" targetRef="Gateway_InvestigationMerge_ASIS" />
    <bpmn:sequenceFlow id="Flow_ASIS_F10" sourceRef="Gateway_InvestigationMerge_ASIS" targetRef="Task_Investigate_ASIS" />
    <bpmn:sequenceFlow id="Flow_ASIS_F11" sourceRef="Task_Investigate_ASIS" targetRef="Gateway_InvestigationEnough_ASIS" />
    <bpmn:sequenceFlow id="Flow_ASIS_F12" name="Нет" sourceRef="Gateway_InvestigationEnough_ASIS" targetRef="Task_CollectAdditional_ASIS" />
    <bpmn:sequenceFlow id="Flow_ASIS_F13" sourceRef="Task_CollectAdditional_ASIS" targetRef="Gateway_InvestigationMerge_ASIS" />
    <bpmn:sequenceFlow id="Flow_ASIS_F14" name="Да" sourceRef="Gateway_InvestigationEnough_ASIS" targetRef="Gateway_DocMerge_ASIS" />
    <bpmn:sequenceFlow id="Flow_ASIS_F15" sourceRef="Gateway_DocMerge_ASIS" targetRef="Task_Docs_ASIS" />
    <bpmn:sequenceFlow id="Flow_ASIS_F16" sourceRef="Task_Docs_ASIS" targetRef="Task_Sign_ASIS" />
    <bpmn:sequenceFlow id="Flow_ASIS_F17" sourceRef="Task_Sign_ASIS" targetRef="Gateway_DocsApproved_ASIS" />
    <bpmn:sequenceFlow id="Flow_ASIS_F18" name="Нет" sourceRef="Gateway_DocsApproved_ASIS" targetRef="Task_ReworkDocs_ASIS" />
    <bpmn:sequenceFlow id="Flow_ASIS_F19" sourceRef="Task_ReworkDocs_ASIS" targetRef="Gateway_DocMerge_ASIS" />
    <bpmn:sequenceFlow id="Flow_ASIS_F20" name="Да" sourceRef="Gateway_DocsApproved_ASIS" targetRef="Task_Approve_ASIS" />
    <bpmn:sequenceFlow id="Flow_ASIS_F21" sourceRef="Task_Approve_ASIS" targetRef="Task_SendDocs_ASIS" />
    <bpmn:sequenceFlow id="Flow_ASIS_F22" sourceRef="Task_SendDocs_ASIS" targetRef="Task_Actions_ASIS" />
    <bpmn:sequenceFlow id="Flow_ASIS_F23" sourceRef="Task_Actions_ASIS" targetRef="Task_Execute_ASIS" />
    <bpmn:sequenceFlow id="Flow_ASIS_F24" sourceRef="Task_Execute_ASIS" targetRef="Task_Control_ASIS" />
    <bpmn:sequenceFlow id="Flow_ASIS_F25" sourceRef="Task_Control_ASIS" targetRef="EndEvent_ASIS" />
  </bpmn:process>
