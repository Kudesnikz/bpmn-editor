<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Incident_TOBE" targetNamespace="https://sergeygalay.github.io/bpmn-editor/incident-investigation-to-be">
  <bpmn:collaboration id="Collaboration_Incident_TOBE">
    <bpmn:participant id="Participant_Company_TOBE" name="Компания" processRef="Process_Incident_TOBE"/>
    <bpmn:participant id="Participant_Med_TOBE" name="Медицинская организация"/>
    <bpmn:participant id="Participant_Gov_TOBE" name="Государственные / надзорные органы"/>
    <bpmn:messageFlow id="Message_TOBE_MedHelp" name="Медицинская помощь / первичные данные" sourceRef="Task_Report_TOBE" targetRef="Participant_Med_TOBE"/>
    <bpmn:messageFlow id="Message_TOBE_315U" name="315У / уточнение категории" sourceRef="Participant_Med_TOBE" targetRef="Task_Classify_TOBE"/>
    <bpmn:messageFlow id="Message_TOBE_NotifyGov" name="Обязательное уведомление" sourceRef="Task_Notify_TOBE" targetRef="Participant_Gov_TOBE"/>
    <bpmn:messageFlow id="Message_TOBE_DocsGov" name="Электронный комплект документов" sourceRef="Task_Send_TOBE" targetRef="Participant_Gov_TOBE"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_Incident_TOBE" name="Расследование происшествия с ИИ-помощником — TO BE" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Incident_TOBE">
      <bpmn:lane id="Lane_Employee_TOBE" name="Сотрудник / мастер / диспетчер"><bpmn:flowNodeRef>StartEvent_TOBE</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Report_TOBE</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_PBIOT_TOBE" name="ПБиОТ / расследователь"><bpmn:flowNodeRef>Task_Classify_TOBE</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Notify_TOBE</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_NotifyMerge_TOBE</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Collect_TOBE</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Missing_TOBE</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Additional_TOBE</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_Commission_TOBE" name="Комиссия / профильные эксперты"><bpmn:flowNodeRef>Task_ConfirmCommission_TOBE</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Interview_TOBE</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Root_TOBE</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Cause_TOBE</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Agree_TOBE</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Review_TOBE</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Docs_TOBE</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Rework_TOBE</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_AI_TOBE" name="ИИ-помощник / корпоративные системы"><bpmn:flowNodeRef>Task_Card_TOBE</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Notify_TOBE</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_RecommendCommission_TOBE</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_DataMerge_TOBE</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Check_TOBE</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Enough_TOBE</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Questions_TOBE</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Analyze_TOBE</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Actions_TOBE</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Draft_TOBE</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_DocMerge_TOBE</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Audit_TOBE</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Send_TOBE</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_RegisterKDMerge_TOBE</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_RegisterKD_TOBE</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_ControlMerge_TOBE</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Monitor_TOBE</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Done_TOBE</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Remind_TOBE</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_Leadership_TOBE" name="Руководство / ответственные за КД"><bpmn:flowNodeRef>Task_ExecuteKD_TOBE</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Effect_TOBE</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Effective_TOBE</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Adjust_TOBE</bpmn:flowNodeRef><bpmn:flowNodeRef>EndEvent_TOBE</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_TOBE" name="Происшествие"/>
    <bpmn:userTask id="Task_Report_TOBE" name="Сообщить через единую точку входа и организовать первичное реагирование"/>
    <bpmn:serviceTask id="Task_Card_TOBE" name="Создать карточку, черновик уведомления / «Молнии» и предложить классификацию"/>
    <bpmn:userTask id="Task_Classify_TOBE" name="Подтвердить / при необходимости пересмотреть классификацию"/>
    <bpmn:exclusiveGateway id="Gateway_Notify_TOBE" name="Нужно уведомить внешние органы?"/>
    <bpmn:serviceTask id="Task_Notify_TOBE" name="Сформировать и направить обязательное уведомление"/>
    <bpmn:exclusiveGateway id="Gateway_NotifyMerge_TOBE" name="XOR merge"/>
    <bpmn:serviceTask id="Task_RecommendCommission_TOBE" name="Рекомендовать состав комиссии"/>
    <bpmn:userTask id="Task_ConfirmCommission_TOBE" name="Подтвердить состав комиссии и роли"/>
    <bpmn:manualTask id="Task_Collect_TOBE" name="Собрать материалы по чек-листу"/>
    <bpmn:exclusiveGateway id="Gateway_DataMerge_TOBE" name="XOR merge"/>
    <bpmn:serviceTask id="Task_Check_TOBE" name="Проверить полноту материалов и выявить пробелы"/>
    <bpmn:exclusiveGateway id="Gateway_Enough_TOBE" name="Материалов достаточно?"/>
    <bpmn:manualTask id="Task_Missing_TOBE" name="Дособрать недостающие материалы"/>
    <bpmn:serviceTask id="Task_Questions_TOBE" name="Сформировать вопросы для интервью"/>
    <bpmn:userTask id="Task_Interview_TOBE" name="Провести осмотр и интервью участников"/>
    <bpmn:serviceTask id="Task_Analyze_TOBE" name="Транскрибировать, выявить противоречия, восстановить цепочку событий и гипотезы причины"/>
    <bpmn:userTask id="Task_Root_TOBE" name="Проверить и подтвердить коренную причину"/>
    <bpmn:exclusiveGateway id="Gateway_Cause_TOBE" name="Причина обоснована?"/>
    <bpmn:userTask id="Task_Additional_TOBE" name="Назначить дополнительный сбор материалов"/>
    <bpmn:serviceTask id="Task_Actions_TOBE" name="Предложить КД и проверить связь каждого мероприятия с причиной"/>
    <bpmn:userTask id="Task_Agree_TOBE" name="Согласовать КД, ответственных и сроки"/>
    <bpmn:serviceTask id="Task_Draft_TOBE" name="Сформировать черновики Формы 5 / Н-1 / внутреннего акта"/>
    <bpmn:exclusiveGateway id="Gateway_DocMerge_TOBE" name="XOR merge"/>
    <bpmn:serviceTask id="Task_Audit_TOBE" name="Валидировать документы: пропуски, искажения и противоречия первичным материалам"/>
    <bpmn:userTask id="Task_Review_TOBE" name="Проверить, согласовать и подписать документы по действующим требованиям"/>
    <bpmn:exclusiveGateway id="Gateway_Docs_TOBE" name="Документы согласованы?"/>
    <bpmn:userTask id="Task_Rework_TOBE" name="Доработать документы"/>
    <bpmn:serviceTask id="Task_Send_TOBE" name="При необходимости направить электронный комплект в предусмотренные органы"/>
    <bpmn:exclusiveGateway id="Gateway_RegisterKDMerge_TOBE" name="XOR merge"/>
    <bpmn:serviceTask id="Task_RegisterKD_TOBE" name="Поставить КД на контроль в системе"/>
    <bpmn:userTask id="Task_ExecuteKD_TOBE" name="Выполнить корректирующее действие"/>
    <bpmn:exclusiveGateway id="Gateway_ControlMerge_TOBE" name="XOR merge"/>
    <bpmn:serviceTask id="Task_Monitor_TOBE" name="Контролировать статус и срок КД"/>
    <bpmn:exclusiveGateway id="Gateway_Done_TOBE" name="КД выполнено?"/>
    <bpmn:serviceTask id="Task_Remind_TOBE" name="Зафиксировать просрочку / напомнить и продолжить контроль"/>
    <bpmn:userTask id="Task_Effect_TOBE" name="Проверить эффективность КД / провести аудит"/>
    <bpmn:exclusiveGateway id="Gateway_Effective_TOBE" name="КД эффективно?"/>
    <bpmn:userTask id="Task_Adjust_TOBE" name="Скорректировать КД"/>
    <bpmn:endEvent id="EndEvent_TOBE" name="Завершено"/>
    <bpmn:sequenceFlow id="Flow_TOBE_01" sourceRef="StartEvent_TOBE" targetRef="Task_Report_TOBE"/>
    <bpmn:sequenceFlow id="Flow_TOBE_02" sourceRef="Task_Report_TOBE" targetRef="Task_Card_TOBE"/>
    <bpmn:sequenceFlow id="Flow_TOBE_03" sourceRef="Task_Card_TOBE" targetRef="Task_Classify_TOBE"/>
    <bpmn:sequenceFlow id="Flow_TOBE_04" sourceRef="Task_Classify_TOBE" targetRef="Gateway_Notify_TOBE"/>
    <bpmn:sequenceFlow id="Flow_TOBE_05" name="Да" sourceRef="Gateway_Notify_TOBE" targetRef="Task_Notify_TOBE"/>
    <bpmn:sequenceFlow id="Flow_TOBE_06" sourceRef="Task_Notify_TOBE" targetRef="Gateway_NotifyMerge_TOBE"/>
    <bpmn:sequenceFlow id="Flow_TOBE_07" name="Нет" sourceRef="Gateway_Notify_TOBE" targetRef="Gateway_NotifyMerge_TOBE"/>
    <bpmn:sequenceFlow id="Flow_TOBE_08" sourceRef="Gateway_NotifyMerge_TOBE" targetRef="Task_RecommendCommission_TOBE"/>
    <bpmn:sequenceFlow id="Flow_TOBE_09" sourceRef="Task_RecommendCommission_TOBE" targetRef="Task_ConfirmCommission_TOBE"/>
    <bpmn:sequenceFlow id="Flow_TOBE_10" sourceRef="Task_ConfirmCommission_TOBE" targetRef="Task_Collect_TOBE"/>
    <bpmn:sequenceFlow id="Flow_TOBE_11" sourceRef="Task_Collect_TOBE" targetRef="Gateway_DataMerge_TOBE"/>
    <bpmn:sequenceFlow id="Flow_TOBE_12" sourceRef="Gateway_DataMerge_TOBE" targetRef="Task_Check_TOBE"/>
    <bpmn:sequenceFlow id="Flow_TOBE_13" sourceRef="Task_Check_TOBE" targetRef="Gateway_Enough_TOBE"/>
    <bpmn:sequenceFlow id="Flow_TOBE_14" name="Нет" sourceRef="Gateway_Enough_TOBE" targetRef="Task_Missing_TOBE"/>
    <bpmn:sequenceFlow id="Flow_TOBE_15" sourceRef="Task_Missing_TOBE" targetRef="Gateway_DataMerge_TOBE"/>
    <bpmn:sequenceFlow id="Flow_TOBE_16" name="Да" sourceRef="Gateway_Enough_TOBE" targetRef="Task_Questions_TOBE"/>
    <bpmn:sequenceFlow id="Flow_TOBE_17" sourceRef="Task_Questions_TOBE" targetRef="Task_Interview_TOBE"/>
    <bpmn:sequenceFlow id="Flow_TOBE_18" sourceRef="Task_Interview_TOBE" targetRef="Task_Analyze_TOBE"/>
    <bpmn:sequenceFlow id="Flow_TOBE_19" sourceRef="Task_Analyze_TOBE" targetRef="Task_Root_TOBE"/>
    <bpmn:sequenceFlow id="Flow_TOBE_20" sourceRef="Task_Root_TOBE" targetRef="Gateway_Cause_TOBE"/>
    <bpmn:sequenceFlow id="Flow_TOBE_21" name="Нет" sourceRef="Gateway_Cause_TOBE" targetRef="Task_Additional_TOBE"/>
    <bpmn:sequenceFlow id="Flow_TOBE_22" sourceRef="Task_Additional_TOBE" targetRef="Gateway_DataMerge_TOBE"/>
    <bpmn:sequenceFlow id="Flow_TOBE_23" name="Да" sourceRef="Gateway_Cause_TOBE" targetRef="Task_Actions_TOBE"/>
    <bpmn:sequenceFlow id="Flow_TOBE_24" sourceRef="Task_Actions_TOBE" targetRef="Task_Agree_TOBE"/>
    <bpmn:sequenceFlow id="Flow_TOBE_25" sourceRef="Task_Agree_TOBE" targetRef="Task_Draft_TOBE"/>
    <bpmn:sequenceFlow id="Flow_TOBE_26" sourceRef="Task_Draft_TOBE" targetRef="Gateway_DocMerge_TOBE"/>
    <bpmn:sequenceFlow id="Flow_TOBE_27" sourceRef="Gateway_DocMerge_TOBE" targetRef="Task_Audit_TOBE"/>
    <bpmn:sequenceFlow id="Flow_TOBE_28" sourceRef="Task_Audit_TOBE" targetRef="Task_Review_TOBE"/>
    <bpmn:sequenceFlow id="Flow_TOBE_29" sourceRef="Task_Review_TOBE" targetRef="Gateway_Docs_TOBE"/>
    <bpmn:sequenceFlow id="Flow_TOBE_30" name="Нет" sourceRef="Gateway_Docs_TOBE" targetRef="Task_Rework_TOBE"/>
    <bpmn:sequenceFlow id="Flow_TOBE_31" sourceRef="Task_Rework_TOBE" targetRef="Gateway_DocMerge_TOBE"/>
    <bpmn:sequenceFlow id="Flow_TOBE_32" name="Да" sourceRef="Gateway_Docs_TOBE" targetRef="Task_Send_TOBE"/>
    <bpmn:sequenceFlow id="Flow_TOBE_33" sourceRef="Task_Send_TOBE" targetRef="Gateway_RegisterKDMerge_TOBE"/>
    <bpmn:sequenceFlow id="Flow_TOBE_33A" sourceRef="Gateway_RegisterKDMerge_TOBE" targetRef="Task_RegisterKD_TOBE"/>
    <bpmn:sequenceFlow id="Flow_TOBE_34" sourceRef="Task_RegisterKD_TOBE" targetRef="Task_ExecuteKD_TOBE"/>
    <bpmn:sequenceFlow id="Flow_TOBE_35" sourceRef="Task_ExecuteKD_TOBE" targetRef="Gateway_ControlMerge_TOBE"/>
    <bpmn:sequenceFlow id="Flow_TOBE_36" sourceRef="Gateway_ControlMerge_TOBE" targetRef="Task_Monitor_TOBE"/>
    <bpmn:sequenceFlow id="Flow_TOBE_37" sourceRef="Task_Monitor_TOBE" targetRef="Gateway_Done_TOBE"/>
    <bpmn:sequenceFlow id="Flow_TOBE_38" name="Нет" sourceRef="Gateway_Done_TOBE" targetRef="Task_Remind_TOBE"/>
    <bpmn:sequenceFlow id="Flow_TOBE_39" sourceRef="Task_Remind_TOBE" targetRef="Gateway_ControlMerge_TOBE"/>
    <bpmn:sequenceFlow id="Flow_TOBE_40" name="Да" sourceRef="Gateway_Done_TOBE" targetRef="Task_Effect_TOBE"/>
    <bpmn:sequenceFlow id="Flow_TOBE_41" sourceRef="Task_Effect_TOBE" targetRef="Gateway_Effective_TOBE"/>
    <bpmn:sequenceFlow id="Flow_TOBE_42" name="Нет" sourceRef="Gateway_Effective_TOBE" targetRef="Task_Adjust_TOBE"/>
    <bpmn:sequenceFlow id="Flow_TOBE_43" sourceRef="Task_Adjust_TOBE" targetRef="Gateway_RegisterKDMerge_TOBE"/>
    <bpmn:sequenceFlow id="Flow_TOBE_44" name="Да" sourceRef="Gateway_Effective_TOBE" targetRef="EndEvent_TOBE"/>
  </bpmn:process>
