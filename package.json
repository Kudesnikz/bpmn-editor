{
  "name": "bpmn-mcp-editor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted BPMN 2.0 editor with a protected Streamable HTTP MCP server",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "bpmn-js": "18.24.0",
    "bpmn-moddle": "9.0.4",
    "compression": "1.8.1",
    "express": "5.1.0",
    "express-rate-limit": "8.1.0",
    "helmet": "8.1.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/compression": "1.8.1",
    "@types/express": "5.0.3",
    "@types/node": "22.18.0",
    "@types/supertest": "6.0.3",
    "supertest": "7.1.4",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vite": "7.1.3",
    "vitest": "3.2.4"
  },
  "packageManager": "pnpm@10.15.1"
}
